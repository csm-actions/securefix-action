{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    // vitest v5 pulls in tinybench, whose declarations reference DOM types
    // this project has no reason to enable. Declaration files come from
    // dependencies, so checking them buys nothing here.
    "skipLibCheck": true,
    "types": ["node"]
  },
  // Test files are type checked too. They are never bundled into dist because
  // ncc only follows imports from the entrypoint.
  "exclude": ["node_modules"]
  // "ts-node": {
  //   "esm": true,
  //   "experimentalSpecifierResolution": "node",
  // }
}
